# Generated by ontology/generator/build_journey.py — do not edit by hand. <https://migdl.midatahub.org/id/map/data-journey-v4> a dct:BibliographicResource ; dct:title "MiGDL Data Journey: from the District SIS to the Apps" ; dct:hasVersion "v5.0" ; dct:issued "2026-10-22"^^xsd:date ; dct:description "Jira state as drawn is dated 2026-10-22." . <https://migdl.midatahub.org/id/station/district-sis> a migdl:Station ; skos:prefLabel "District SIS" ; migdl:stationNumber 1 ; migdl:plainName "District SIS" ; migdl:technicalName "Skyward, PowerSchool, MISTAR-Q, Infinite Campus, Synergy" ; skos:definition "The district's source of truth. Teachers and registrars make the changes." .
<https://migdl.midatahub.org/id/station/midatahub> a migdl:Station ; skos:prefLabel "MiDataHub" ; migdl:stationNumber 2 ; migdl:plainName "MiDataHub" ; migdl:technicalName "Ed-Fi ODS and MiDH API" ; skos:definition "The state clearinghouse. Stamps every record with a change number and keeps a list of deletes." ; migdl:stationStage <https://migdl.midatahub.org/id/stage/connection-setup> .
<https://migdl.midatahub.org/id/station/bronze> a migdl:Station ; skos:prefLabel "MiGDL Bronze Layer" ; migdl:stationNumber 3 ; migdl:plainName "MiGDL Bronze Layer" ; migdl:technicalName "Receiving dock (raw archive)" ; skos:definition "Every package logged exactly as received. Nothing is ever edited here." ; migdl:stationLayer <https://migdl.midatahub.org/id/layer/bronze> ; migdl:stationStage <https://migdl.midatahub.org/id/stage/bronze-load> .
<https://migdl.midatahub.org/id/station/silver> a migdl:Station ; skos:prefLabel "MiGDL Silver Layer" ; migdl:stationNumber 4 ; migdl:plainName "MiGDL Silver Layer" ; migdl:technicalName "District filing cabinets (one per district)" ; skos:definition "One cabinet per district. Files are kept current; history is kept for people and relationships." ; migdl:stationLayer <https://migdl.midatahub.org/id/layer/silver> ; migdl:stationStage <https://migdl.midatahub.org/id/stage/descriptor-load> ; migdl:stationStage <https://migdl.midatahub.org/id/stage/silver-load> .
<https://migdl.midatahub.org/id/station/gold> a migdl:Station ; skos:prefLabel "MiGDL Gold Layer" ; migdl:stationNumber 5 ; migdl:plainName "MiGDL Gold Layer" ; migdl:technicalName "Statewide consolidation (5a main, 5b model)" ; skos:definition "5a merges all 149 districts into one statewide copy, ~350 shared tables. 5b builds the MiGDL model from 5a: one identity per student, dedup, ISD and district hierarchy." ; migdl:stationLayer <https://migdl.midatahub.org/id/layer/goldstage> ; migdl:stationLayer <https://migdl.midatahub.org/id/layer/gold-conformed> ; migdl:stationLayer <https://migdl.midatahub.org/id/layer/gold-star> ; migdl:stationLayer <https://migdl.midatahub.org/id/layer/staging-temp> ; migdl:stationStage <https://migdl.midatahub.org/id/stage/goldplat-load> .
<https://migdl.midatahub.org/id/station/platinum> a migdl:Station ; skos:prefLabel "MiGDL Platinum Layer" ; migdl:stationNumber 6 ; migdl:plainName "MiGDL Platinum Layer" ; migdl:technicalName "Cove app-ready shelves" ; skos:definition "Pre-built views per application: rosters, early-warning metrics, MiRead context." ; migdl:stationLayer <https://migdl.midatahub.org/id/layer/platinum> .
<https://migdl.midatahub.org/id/station/delivery> a migdl:Station ; skos:prefLabel "Delivery Counter" ; migdl:stationNumber 7 ; migdl:plainName "Delivery Counter" ; migdl:technicalName "MiGDL API and QuickSight + the four Cove apps" ; skos:definition "Where the Cove apps receive the data, protected by the auth handler and district allow-list." ; migdl:stationStage <https://migdl.midatahub.org/id/stage/ready-for-stage> ; migdl:stationStage <https://migdl.midatahub.org/id/stage/complete> . <https://migdl.midatahub.org/id/pain/1> a migdl:PainPoint ; dct:title "No MiGDL pain point at this station." ; dct:description "Data quality issues here belong to the district and SIS vendor." ; migdl:atStation <https://migdl.midatahub.org/id/station/district-sis> .
<https://migdl.midatahub.org/id/pain/2> a migdl:PainPoint ; dct:title "We do not know when a district's changes arrive, or how fast we are allowed to pull them." ; dct:description "Each district sends its changes to MiDataHub on its own schedule, and nobody has written down when. MiDataHub also limits how fast we can pull, but the limit is not documented, so the nightly run is planned blind. The connector also cannot tell which kinds of records actually changed, so it asks for everything." ; migdl:evidenceRef "Flowchart; Backlog Epic 4" ; migdl:atStation <https://migdl.midatahub.org/id/station/midatahub> ; migdl:addressedBy <https://migdl.midatahub.org/id/fix/1> .
<https://migdl.midatahub.org/id/pain/3> a migdl:PainPoint ; dct:title "Nothing is lost here." ; dct:description "Every new record, correction, deletion and ID change from every district is written down exactly as it arrived. This is the last station where the full truth exists." ; migdl:evidenceRef "Current State Sec 3" ; migdl:atStation <https://migdl.midatahub.org/id/station/bronze> .
<https://migdl.midatahub.org/id/pain/4> a migdl:PainPoint ; dct:title "Deleted records never leave (“zombie rows”)." ; dct:description "A delete arrives in Silver carrying only the record's ID and none of the details, so no fingerprint can be built and nothing is found to remove. The record stays, and everything downstream keeps it too: " ; migdl:evidenceRef "Sec 4.4, CR-7, G1" ; migdl:gapGroup "G1" ; migdl:atStation <https://migdl.midatahub.org/id/station/silver> ; migdl:addressedBy <https://migdl.midatahub.org/id/fix/2> .
<https://migdl.midatahub.org/id/pain/5> a migdl:PainPoint ; dct:title "Address or contact-only changes never make it past Silver." ; dct:description "Change detection looks at the student's main record only, not the details attached to it." ; migdl:evidenceRef "Sec 4.3, G2" ; migdl:gapGroup "G2" ; migdl:atStation <https://migdl.midatahub.org/id/station/silver> ; migdl:addressedBy <https://migdl.midatahub.org/id/fix/3> .
<https://migdl.midatahub.org/id/pain/6> a migdl:PainPoint ; dct:title "Corrections are silently thrown away." ; dct:description "Once Gold has a record, 47 kinds of record types (attendance, grades, discipline, assessments and most reference data) can never be changed again, only added to. A corrected grade or attendance mark is quietly skipped because a record with that key already exists." ; migdl:evidenceRef "Sec 4.1, 4.2, G3" ; migdl:gapGroup "G3" ; migdl:atStation <https://migdl.midatahub.org/id/station/gold> ; migdl:addressedBy <https://migdl.midatahub.org/id/fix/4> .
<https://migdl.midatahub.org/id/pain/7> a migdl:PainPoint ; dct:title "When a student's ID is corrected, the system keeps both the old and the new student." ; dct:description "An ID correction arrives as a new record instead of replacing the old record. Separately, when a record's history is updated, the old version is closed in one step and the new one written in another; if the run fails in between, the student has no current record at all." ; migdl:evidenceRef "Sec 4.5, CR-6, G4" ; migdl:gapGroup "G4" ; migdl:atStation <https://migdl.midatahub.org/id/station/gold> ; migdl:addressedBy <https://migdl.midatahub.org/id/fix/5> .
<https://migdl.midatahub.org/id/pain/8> a migdl:PainPoint ; dct:title "One shared warehouse, one checkout line." ; dct:description "All 149 districts write into one shared warehouse and wait their turn, and each one re-does all of its work every night even when nothing changed. One small district took About 65 districts fit in a night; we need 79 today and 150 to 175 by fall. Adding computing power did not help." ; migdl:evidenceRef "Sec 5" ; migdl:atStation <https://migdl.midatahub.org/id/station/gold> ; migdl:addressedBy <https://migdl.midatahub.org/id/fix/6> .
<https://migdl.midatahub.org/id/pain/9> a migdl:PainPoint ; dct:title "App shelves only add, never fix or remove." ; dct:description "Derived and Platinum are built from Gold, and they only ever add rows. A corrected or deleted record upstream leaves the shelf copy untouched, so over time the apps drift away from the data they were built from, even where Gold is right." ; migdl:evidenceRef "Sec 4.7, G5" ; migdl:gapGroup "G5" ; migdl:atStation <https://migdl.midatahub.org/id/station/platinum> ; migdl:addressedBy <https://migdl.midatahub.org/id/fix/7> .
<https://migdl.midatahub.org/id/pain/10> a migdl:PainPoint ; dct:title "Apps and the pipeline share the same warehouse." ; dct:description "When a teacher opens MiEWIMS while districts are still loading, the app's request waits behind the load and gives up." ; migdl:evidenceRef "Backlog Epic 1; DynamoDB proposal" ; migdl:atStation <https://migdl.midatahub.org/id/station/delivery> ; migdl:addressedBy <https://migdl.midatahub.org/id/fix/8> .
<https://migdl.midatahub.org/id/pain/11> a migdl:PainPoint ; dct:title "Running districts side by side breaks the tracker." ; dct:description "The nightly job keeps its place in a shared logbook. Every run reads the whole logbook, so when ten districts start together the storage service refuses the traffic and the runs fail. Until the logbook is split by district, parallel loading is not possible." ; migdl:evidenceRef "Jira MIGDL-658" ; migdl:atStation <https://migdl.midatahub.org/id/station/gold> ; migdl:addressedBy <https://migdl.midatahub.org/id/fix/10> .
<https://migdl.midatahub.org/id/pain/0> a migdl:PainPoint ; dct:title "The tracking system is manual and unreliable." ; dct:description "Loads are started by hand, on no fixed schedule. Progress is tracked in a shared spreadsheet that overwrites itself and matches districts by name. A batch reports success as soon as one district finishes, the check that Gold is ready to run is switched off, and there is no record of what any run actually applied." ; migdl:evidenceRef "Sec 6, CR-1 to CR-5" ; migdl:addressedBy <https://migdl.midatahub.org/id/fix/9> . <https://migdl.midatahub.org/id/fix/1> a migdl:Fix ; dct:title "Find out how much we can pull, then plan the night around it." ; dct:description "Document ODS and DataHub throttling and push cadence; chunk large historical pulls with start and end keys." ; migdl:mapChip "Not yet in Jira" ; migdl:evidenceRef "Optimization Backlog Epic 4 (Ingestion at Scale). Tiger Team 1 leads." .
<https://migdl.midatahub.org/id/fix/2> a migdl:Fix ; dct:title "Tag every record, match on the Ed-Fi ID." ; dct:description "Every Silver record gets a flag (new, changed, deleted, ID changed) and deletes are matched on the Ed-Fi ID, which is always present. A one-time column update on every district, Silver paused for the window, then the missed deletes are replayed oldest to newest." ; migdl:mapChip "Ready for Stage" ; migdl:evidenceRef "Gap G1" ; migdl:realisedBy <https://migdl.midatahub.org/id/work/MIGDL-118> ; migdl:realisedBy <https://migdl.midatahub.org/id/work/MIGDL-280> ; migdl:realisedBy <https://migdl.midatahub.org/id/work/MIGDL-291> ; migdl:realisedBy <https://migdl.midatahub.org/id/work/MIGDL-627> ; migdl:realisedBy <https://migdl.midatahub.org/id/work/MIGDL-392> ; migdl:realisedBy <https://migdl.midatahub.org/id/work/MIGDL-292> .
<https://migdl.midatahub.org/id/fix/3> a migdl:Fix ; dct:title "A child change wakes up the parent." ; dct:description "A change to an address, contact or ID code now moves the student forward so it travels past Silver. Past missed changes are re-sent after promotion." ; migdl:mapChip "Ready for Stage" ; migdl:evidenceRef "Gap G2" ; migdl:realisedBy <https://migdl.midatahub.org/id/work/MIGDL-120> ; migdl:realisedBy <https://migdl.midatahub.org/id/work/MIGDL-293> .
<https://migdl.midatahub.org/id/fix/4> a migdl:Fix ; dct:title "Let Gold accept corrections." ; dct:description "Two Gold load paths: MERGE for simple entities; tree replace (close the old parent and children set, insert the new) for record types with children. Pilot first, then rollout. The descriptor loader already proves MERGE in production." ; migdl:mapChip "Building" ; migdl:evidenceRef "Gap G3" ; migdl:realisedBy <https://migdl.midatahub.org/id/work/MIGDL-294> ; migdl:realisedBy <https://migdl.midatahub.org/id/work/MIGDL-336> ; migdl:realisedBy <https://migdl.midatahub.org/id/work/MIGDL-338> ; migdl:realisedBy <https://migdl.midatahub.org/id/work/MIGDL-337> ; migdl:realisedBy <https://migdl.midatahub.org/id/work/MIGDL-339> ; migdl:realisedBy <https://migdl.midatahub.org/id/work/MIGDL-684> ; migdl:realisedBy <https://migdl.midatahub.org/id/work/MIGDL-685> ; migdl:realisedBy <https://migdl.midatahub.org/id/work/MIGDL-340> .
<https://migdl.midatahub.org/id/fix/5> a migdl:Fix ; dct:title "Let Gold remove what Silver deleted." ; dct:description "Silver's deletes are extracted as a feed and applied at Gold, keys aligned so a delete finds its row. The same key alignment resolves ID changes, so one student is one record. Ships with fix 4; depends on fix 2." ; migdl:mapChip "Building" ; migdl:evidenceRef "Gap G4" ; migdl:realisedBy <https://migdl.midatahub.org/id/work/MIGDL-334> ; migdl:realisedBy <https://migdl.midatahub.org/id/work/MIGDL-332> ; migdl:realisedBy <https://migdl.midatahub.org/id/work/MIGDL-333> .
<https://migdl.midatahub.org/id/fix/6> a migdl:Fix ; dct:title "Run districts in batches, not one at a time." ; dct:description "Three tracks: make the nightly refresh automatic with cleanup built in; rework the job so many districts load per run; research splitting Gold Main deltas from a full rebuild of the shelves. Ten districts per job brings 29 days to 2; twenty brings it to 1." ; migdl:mapChip "Building" ; migdl:evidenceRef "Depends on fix 10" ; migdl:realisedBy <https://migdl.midatahub.org/id/work/MIGDL-689> ; migdl:realisedBy <https://migdl.midatahub.org/id/work/MIGDL-690> ; migdl:realisedBy <https://migdl.midatahub.org/id/work/MIGDL-691> ; migdl:realisedBy <https://migdl.midatahub.org/id/work/MIGDL-692> ; migdl:realisedBy <https://migdl.midatahub.org/id/work/MIGDL-693> ; migdl:realisedBy <https://migdl.midatahub.org/id/work/MIGDL-694> ; migdl:realisedBy <https://migdl.midatahub.org/id/work/MIGDL-695> ; migdl:realisedBy <https://migdl.midatahub.org/id/work/MIGDL-696> ; migdl:realisedBy <https://migdl.midatahub.org/id/work/MIGDL-697> ; migdl:realisedBy <https://migdl.midatahub.org/id/work/MIGDL-698> ; migdl:realisedBy <https://migdl.midatahub.org/id/work/MIGDL-683> ; migdl:realisedBy <https://migdl.midatahub.org/id/work/MIGDL-659> .
<https://migdl.midatahub.org/id/fix/7> a migdl:Fix ; dct:title "Rebuild the shelves every night, for now." ; dct:description "Decision of 21 October: Gold Derived and Platinum are rebuilt in full on every run rather than corrected row by row, because every shelf has its own shape. Row-by-row maintenance is revisited after fixes 4 to 6 land." ; migdl:mapChip "Designing" ; migdl:evidenceRef "Gap G5" ; migdl:realisedBy <https://migdl.midatahub.org/id/work/MIGDL-296> ; migdl:realisedBy <https://migdl.midatahub.org/id/work/MIGDL-295> ; migdl:realisedBy <https://migdl.midatahub.org/id/work/MIGDL-629> ; migdl:realisedBy <https://migdl.midatahub.org/id/work/MIGDL-341> ; migdl:realisedBy <https://migdl.midatahub.org/id/work/MIGDL-342> ; migdl:realisedBy <https://migdl.midatahub.org/id/work/MIGDL-343> ; migdl:realisedBy <https://migdl.midatahub.org/id/work/MIGDL-344> ; migdl:realisedBy <https://migdl.midatahub.org/id/work/MIGDL-345> .
<https://migdl.midatahub.org/id/fix/8> a migdl:Fix ; dct:title "Give the apps their own delivery door." ; dct:description "The apps read from DynamoDB instead of the shared warehouse, so a morning request never waits behind a load. The first endpoints are live (19 October release); the rest are staged for promotion." ; migdl:mapChip "Building" ; migdl:evidenceRef "Tiger Team 1" ; migdl:realisedBy <https://migdl.midatahub.org/id/work/MIGDL-662> ; migdl:realisedBy <https://migdl.midatahub.org/id/work/MIGDL-103> ; migdl:realisedBy <https://migdl.midatahub.org/id/work/MIGDL-83> ; migdl:realisedBy <https://migdl.midatahub.org/id/work/MIGDL-104> .
<https://migdl.midatahub.org/id/fix/9> a migdl:Fix ; dct:title "A real status board: which districts loaded, which did not, and why." ; dct:description "Scheduling: each layer gets its own ready flag so Bronze and Silver can run in the day and Gold, Platinum and DynamoDB at night; every district mapped to a batch; Redshift schedule design still to do. Visibility: a layer status dashboard is in progress, and the runtime and error logging to feed it has no tickets yet." ; migdl:mapChip "Building" ; migdl:evidenceRef "Transferred to MAISA Operations with Cloudwick" ; migdl:realisedBy <https://migdl.midatahub.org/id/work/MIGDL-303> ; migdl:realisedBy <https://migdl.midatahub.org/id/work/MIGDL-304> ; migdl:realisedBy <https://migdl.midatahub.org/id/work/MIGDL-308> ; migdl:realisedBy <https://migdl.midatahub.org/id/work/MIGDL-305> ; migdl:realisedBy <https://migdl.midatahub.org/id/work/MIGDL-307> ; migdl:realisedBy <https://migdl.midatahub.org/id/work/MIGDL-621> .
<https://migdl.midatahub.org/id/fix/10> a migdl:Fix ; dct:title "Split the logbook by district." ; dct:description "Store each district's tracker entries separately so a run reads only its own slice. Unlocks fix 6." ; migdl:mapChip "Not Started" ; migdl:evidenceRef "Unlocks fix 6" ; migdl:realisedBy <https://migdl.midatahub.org/id/work/MIGDL-658> . <https://migdl.midatahub.org/id/claim/MIGDL-118-fix2> a migdl:TicketClaim ; migdl:claimsAbout <https://migdl.midatahub.org/id/work/MIGDL-118> ; migdl:claimedBy <https://migdl.midatahub.org/id/map/data-journey-v4> ; migdl:claimedStatus "Ready for Stage" ; migdl:agreesWithJira true .
